rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'clothingkulture46@gmail.com';
    }
    match /products/{id} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }
    match /orders/{id} {
      allow create: if true;
      allow read: if isAdmin()
        || (request.auth != null && resource.data.customer.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
